#!/usr/bin/env bash
# `omarchy plugin add` only clones files; this is the rest of the install.
#   ./setup              check dependencies, build the touch helper, link the CLI
#   ./setup --uninstall  stop any session and undo the above
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
link="$HOME/.local/bin/omarchy-sidecar"

if [[ ${1:-} == --uninstall ]]; then
  "$root/bin/omarchy-sidecar" stop 2>/dev/null || true
  [[ -L $link && $(readlink "$link") == "$root/bin/omarchy-sidecar" ]] && rm -f "$link"
  make -s -C "$root/pointer" clean
  echo "Sidecar - leoaba: session stopped, CLI link and build files removed."
  echo "Remove the plugin itself with: omarchy plugin remove io.github.leoaba.sidecar"
  exit 0
fi

# Everything is in Omarchy's base install except, occasionally, wf-recorder.
need=()
command -v wf-recorder >/dev/null || need+=(wf-recorder)
command -v avahi-browse >/dev/null || need+=(avahi)
command -v wayland-scanner >/dev/null || need+=(wayland)
command -v cc >/dev/null || need+=(gcc)
command -v make >/dev/null || need+=(make)
command -v pkg-config >/dev/null || need+=(pkgconf)
command -v python3 >/dev/null || need+=(python)
if ((${#need[@]})); then
  echo "Installing: ${need[*]}"
  omarchy pkg add "${need[@]}"
fi

# Touch/pencil input: a tiny zwlr_virtual_pointer client, built in place.
make -s -C "$root/pointer"

# Put the CLI on PATH (only if nothing else owns that name).
mkdir -p "$(dirname "$link")"
if [[ ! -e $link || -L $link ]]; then
  ln -sfn "$root/bin/omarchy-sidecar" "$link"
fi

echo "Sidecar - leoaba is ready."
echo "  1. Install OpenDisplay on the iPad: https://testflight.apple.com/join/3NYaY11c"
echo "  2. Click the tablet icon in the bar (or: omarchy-sidecar connect)."
command -v usbmuxd >/dev/null || echo "  Optional, for USB: omarchy pkg add usbmuxd, then replug the iPad and tap Trust."
